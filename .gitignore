out*/
tests/*.kl
# Derived call-graph cache. Kept OUT of KLambda/ so go:embed cannot sweep
# it into the binary (see yggdrasil.shen's *callgraph-cache* note).
/callgraph-cache.shen
KLambda/callgraph-*.shen
*.fasl

# Compiled Go binary bundled into the uvx wheel at build time.
pybin/*/_bin/

# Default `go build` output. `/ygg` is the name docs/port-contract.md and the
# acceptance commands build under (`go build -o ./ygg .`).
/yggdrasil
/yggdrasil_bin
/ygg

# Local launcher binaries built by integration scripts.
.bin/

# Runtime trace written by a --trace artifact run from the repo root.
/yggdrasil.trace
