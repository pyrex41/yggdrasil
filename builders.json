{
  "_comment": [
    "Stage-2 builder + run recipes for Yggdrasil, one entry per target.",
    "Faithful to the showboat-verified DEMO.md. Read by both the `yggdrasil`",
    "CLI (build/run subcommands) and Bifrost's shake-then-run mode.",
    "",
    "Placeholders substituted at run time (all absolute paths):",
    "  {yggroot}   Yggdrasil repo root (holds yggdrasil.shen, KLambda/, builders/)",
    "  {outdir}    the shake output dir (kernel.kl + <prog>.kl + manifest)",
    "  {tmp}       a scratch dir for intermediate build tools",
    "  {shen_lua}/{shen_go}/{shen_rust}/{shenscript}/{shen_julia}/{shen_scheme}/",
    "  {shen_swift}/{shen_erl}/{shen_cl}/{shen_truffle}/{shen_c} sibling port repo roots;",
    "              default to {yggroot}/../<name>, overridable via the env var",
    "              named in each target's 'dir_env'.",
    "",
    "Each target: 'build' is a list of steps (argv + optional cwd/env), run in",
    "order; 'run' is the argv that executes the built artifact and prints to",
    "stdout; 'needs' lists external tools that must be on PATH (else SKIP).",
    "The Erlang target compiles the shaken slice to BEAM with shen-erl; scheme",
    "compiles via kl->scheme; swift interprets the minimal slice directly.",
    "The C target (shen-c) emits NativeFunction C + Makefile/CMakeLists and",
    "links libshenc.a (option 5 rung 1; not eval_kl_object of the source)."
  ],

  "lisp": {
    "run_impl": "shen-cl",
    "dir_env": "YGGDRASIL_SHEN_CL_DIR",
    "needs": ["sbcl"],
    "build": [
      {"argv": ["{yggroot}/builders/lisp/build.sh", "{outdir}", "{outdir}/app-lisp"],
       "cwd": "{yggroot}", "env": {"LISP_IMPL": "sbcl", "SHEN_CL": "{shen_cl}"}}
    ],
    "run": ["{outdir}/app-lisp"]
  },

  "lua": {
    "run_impl": "shen-lua",
    "dir_env": "YGGDRASIL_SHEN_LUA_DIR",
    "needs": ["luajit"],
    "build": [
      {"argv": ["luajit", "{shen_lua}/bin/yggdrasil-build.lua", "{outdir}", "{outdir}/app.lua"]}
    ],
    "run": ["luajit", "{outdir}/app.lua"]
  },

  "go": {
    "run_impl": "shen-go",
    "dir_env": "YGGDRASIL_SHEN_GO_DIR",
    "needs": ["go"],
    "build": [
      {"argv": ["go", "build", "-o", "{tmp}/yggdrasil-build", "./cmd/yggdrasil-build"],
       "cwd": "{shen_go}"},
      {"argv": ["{tmp}/yggdrasil-build", "-shen-go", "{shen_go}", "{outdir}", "{outdir}/app-go"]},
      {"argv": ["go", "build", "-o", "{outdir}/app-go-bin", "."], "cwd": "{outdir}/app-go"}
    ],
    "run": ["{outdir}/app-go-bin"]
  },

  "rust": {
    "run_impl": "shen-rust",
    "dir_env": "YGGDRASIL_SHEN_RUST_DIR",
    "needs": ["cargo"],
    "build": [
      {"argv": ["cargo", "run", "-q", "--release", "-p", "yggdrasil-build", "--",
                "{outdir}", "{outdir}/app-rust"], "cwd": "{shen_rust}"},
      {"argv": ["cargo", "build", "--release", "-q"], "cwd": "{outdir}/app-rust"}
    ],
    "run": ["{outdir}/app-rust/target/release/app-rust"]
  },

  "js": {
    "run_impl": "ShenScript",
    "dir_env": "YGGDRASIL_SHENSCRIPT_DIR",
    "needs": ["node"],
    "build": [
      {"argv": ["node", "{shenscript}/bin/yggdrasil-build.js", "{outdir}", "{outdir}/app.js"]}
    ],
    "run": ["node", "{outdir}/app.js"]
  },

  "julia": {
    "run_impl": "shen-julia",
    "dir_env": "YGGDRASIL_SHEN_JULIA_DIR",
    "needs": ["julia"],
    "build": [
      {"argv": ["julia", "--project={shen_julia}", "{shen_julia}/bin/yggdrasil-build.jl",
                "{outdir}", "{outdir}/app-julia", "--sysimage"]}
    ],
    "run": ["{outdir}/app-julia/run"]
  },

  "scheme": {
    "run_impl": "shen-scheme",
    "dir_env": "YGGDRASIL_SHEN_SCHEME_DIR",
    "needs": ["chez"],
    "build": [
      {"argv": ["{yggroot}/builders/scheme/build.sh", "{outdir}", "{outdir}/app-scheme"],
       "env": {"SHEN_SCHEME": "{shen_scheme}"}}
    ],
    "run": ["{outdir}/app-scheme/run"]
  },

  "swift": {
    "run_impl": "shen-swift",
    "dir_env": "YGGDRASIL_SHEN_SWIFT_DIR",
    "needs": ["swift"],
    "build": [
      {"argv": ["{yggroot}/builders/swift/build.sh", "{outdir}", "{outdir}/app-swift"],
       "env": {"SHEN_SWIFT": "{shen_swift}"}}
    ],
    "run": ["{outdir}/app-swift/run"]
  },

  "erlang": {
    "run_impl": "shen-erl",
    "dir_env": "YGGDRASIL_SHEN_ERL_DIR",
    "needs": ["erl", "erlc", "make", "cc", "curl", "unzip", "tar", "shasum"],
    "build": [
      {"argv": ["{yggroot}/builders/erlang/build.sh", "{outdir}", "{outdir}/app-erlang"],
       "env": {"SHEN_ERL": "{shen_erl}"}}
    ],
    "run": ["{outdir}/app-erlang/run"]
  },

  "hvm": {
    "run_impl": "shen-inets",
    "dir_env": "YGGDRASIL_SHEN_INETS_DIR",
    "needs": ["python3", "hvm"],
    "build": [
      {"argv": ["python3", "{shen_inets}/build_shake.py", "{outdir}", "{outdir}/app.hvml"]}
    ],
    "run": ["python3", "{shen_inets}/run_app.py", "{outdir}/app.hvml"]
  },

  "truffle": {
    "run_impl": "shen-truffle",
    "dir_env": "YGGDRASIL_SHEN_TRUFFLE_DIR",
    "needs": ["java", "mvn"],
    "build": [
      {"argv": ["mvn", "-q", "-DskipTests", "package"], "cwd": "{shen_truffle}"},
      {"argv": ["java", "-jar", "{shen_truffle}/target/yggdrasil-builder.jar",
                "--format", "jvm", "--runtime", "{shen_truffle}/target/shen-truffle.jar",
                "{outdir}", "{outdir}/app-truffle"]}
    ],
    "run": ["{outdir}/app-truffle/bin/shen-truffle"]
  },

  "truffle-native": {
    "run_impl": "shen-truffle-native",
    "dir_env": "YGGDRASIL_SHEN_TRUFFLE_DIR",
    "needs": ["java", "mvn", "native-image"],
    "build": [
      {"argv": ["mvn", "-q", "-DskipTests", "package"], "cwd": "{shen_truffle}"},
      {"argv": ["java", "-jar", "{shen_truffle}/target/yggdrasil-builder.jar",
                "--format", "native", "--runtime", "{shen_truffle}/target/shen-truffle.jar",
                "{outdir}", "{outdir}/app-truffle-native"]}
    ],
    "run": ["{outdir}/app-truffle-native"]
  },

  "c": {
    "run_impl": "shen-c",
    "dir_env": "YGGDRASIL_SHEN_C_DIR",
    "needs": ["cc", "pkg-config", "make"],
    "build": [
      {"argv": ["{yggroot}/builders/c/build.sh", "{outdir}", "{outdir}/app-c"],
       "env": {"SHEN_C": "{shen_c}"}}
    ],
    "run": ["{outdir}/app-c/app"]
  },

  "forth": {
    "run_impl": "shen-forth",
    "dir_env": "YGGDRASIL_SHEN_FORTH_DIR",
    "needs": ["gforth", "shen-forth"],
    "build": [
      {"argv": ["shen-forth", "script", "{outdir}/app.shen"], "cwd": "{yggroot}"}
    ],
    "run": ["{outdir}/app-forth"]
  }
}
