  "go": {
    "run_impl": "shen-go",
    "dir_env": "YGGDRASIL_SHEN_GO_DIR",
    "needs": [
      "go"
    ],
    "port_reads": [
      "*stinput*",
      "*stoutput*",
      "*home-directory*",
      "*property-vector*",
      "shen.*lambdatable*"
    ],
    "port_reads_verified": true,
    "build": [
      {
        "argv": [
          "go",
          "build",
          "-o",
          "{tmp}/yggdrasil-build",
          "./cmd/yggdrasil-build"
        ],
        "cwd": "{shen_go}"
      },
      {
        "argv": [
          "{tmp}/yggdrasil-build",
          "-shen-go",
          "{shen_go}",
          "{outdir}",
          "{outdir}/app-go"
        ]
      },
      {
        "argv": [
          "go",
          "build",
          "-o",
          "{outdir}/app-go-bin",
          "."
        ],
        "cwd": "{outdir}/app-go"
      }
    ],
    "run": [
      "{outdir}/app-go-bin"
    ],
    "native_overrides": [
      "adjoin",
      "append",
      "arity",
      "assoc",
      "boolean?",
      "bound?",
      "concat",
      "difference",
      "element?",
      "empty?",
      "fail",
      "fn",
      "fst",
      "get",
      "hdstr",
      "head",
      "integer?",
      "intersection",
      "length",
      "limit",
      "map",
      "not",
      "nth",
      "protect",
      "put",
      "remove",
      "reverse",
      "shen.+string?",
      "shen.abs",
      "shen.alpha?",
      "shen.alphanums?",
      "shen.analyse-symbol?",
      "shen.analyse-variable?",
      "shen.byte->digit",
      "shen.digit?",
      "shen.lowercase?",
      "shen.misc?",
      "shen.posint?",
      "shen.pvar?",
      "shen.string->bytes",
      "shen.uppercase?",
      "snd",
      "string->symbol",
      "sum",
      "symbol?",
      "tail",
      "thaw",
      "tuple?",
      "union",
      "unput",
      "variable?",
      "vector",
      "vector->",
      "vector?"
    ],
    "native_overrides_verified": true,
    "native_overrides_source": "kl/kernelfast.go InstallKernelFast (shen-go 24b2c00): every symbol rebound to a native there",
    "special_forms": [
      "do",
      "not"
    ],
    "special_forms_source": "src/compiler.shen:6 `Env [do X Y] -> [$do (parse Env X) (parse Env Y)]` lowers `do` syntactically, and codegen/codegen.go:958 `\"not\": {1, \"PrimNot\"}` in shenPrimitive lowers `not` to an inline PrimNot call (shen-go da55c5d): neither emits a PrimFunc symbol lookup, so neither is a call edge in the generated module"
  },
