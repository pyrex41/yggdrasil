      "shen.*step*",
      "shen.*synonyms*",
      "shen.*tc*",
      "shen.*tracking*",
      "shen.*userdefs*"
    ],
    "port_reads_verified": false,
    "build": [
      {
        "argv": [
          "{yggroot}/builders/lisp/build.sh",
          "{outdir}",
          "{outdir}/app-lisp"
        ],
        "cwd": "{yggroot}",
        "env": {
